# Build outputs (rustudio's tree).
target/
shots/
__pycache__/
*.rbxlx.lock
crates/rustudio-android/libs/**/*.so

# Wine prefixes and Studio data folders checks leave behind: their links lead
# out of the tree (dosdevices/z: is /), and cargo walks every file git doesn't
# ignore the first time a profile builds ("failed to determine package
# fingerprint ... Permission denied").
checks/**/dosdevices/
checks/**/waxley-data/

# Generated probe output.
tools/parity_probe/*/runs/
tools/fidelity/truss/build.log
tools/fidelity/truss/tests.log
docs/fidelity/

# rove: the vendor/ directories are checked in on purpose (see
# rove/THIRD_PARTY.md), including inner build/ directories, so nothing here
# may be excluded by a bare "build/" pattern.
