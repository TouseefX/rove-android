* text=auto
*.rs text eol=lf
*.md text eol=lf
*.luac -text
*.bin -text
*.rbxp -text
*.dex -text

# Vendored crates and rove's fixtures are not our source; keep GitHub's
# language statistics and diff rendering out of them.
vendor/** -whitespace linguist-vendored=true
rove/vendor/** -whitespace linguist-vendored=true linguist-generated=true
rove/rust-runtime-sys/vendor/** -whitespace linguist-vendored=true
rove/rust-client/vendor/** -whitespace linguist-vendored=true
rove/vendor/roblox-player-scripts-745/** -text
checks/** linguist-documentation=true
docs/** linguist-documentation=true
