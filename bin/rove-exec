#!/usr/bin/env bash
# rove-exec — minimal headless Roblox executor (Mac).
#   ./bin/rove-exec <place-id> <script.luau> [seconds]
# Official Luau VM + rove's Rust replication engine. Low-RAM mode on.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BIN="$ROOT/rust-client/target/release/rove"
if [[ $# -lt 2 ]]; then
  echo "usage: $(basename "$0") <place-id> <script.luau> [seconds]" >&2
  exit 2
fi
PLACE="$1"; SCRIPT="$2"; SECS="${3:-20}"
[[ -x "$BIN" ]] || { echo "build first: cargo build --release --locked --manifest-path rust-client/Cargo.toml --bin rove" >&2; exit 1; }
export ROVE_TOLERATE_UNKNOWN_SETS=1
exec "$BIN" join --place-id "$PLACE" --script "$SCRIPT" --session-seconds "$SECS" --lightweight
